# Environment variables (never commit!)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs
dist/
build/
*.log

# Uploaded images (temporary)
backend/uploads/

# OS
.DS_Store
Thumbs.db

# Testing
*.test.js
coverage/

# Misc
.cache/
temp/
tmp/
